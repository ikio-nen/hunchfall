# hunchfall — backend environment template.
# Copy to .env and fill in. PAPER TRADING ONLY: no real-money keys exist here.
# Every threshold the trading core uses comes from these variables.

# --- Polymarket data endpoints (public, no trading keys in paper mode) ---
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_DATA_API_URL=https://data-api.polymarket.com
# Verified GDELT 2.1 DOC API base (keyless).
GDELT_DOC_URL=https://api.gdeltproject.org/api/v2/doc/doc

# --- Jev decision model (TypeSafe hosted API) ---
# Live endpoint is POST {JEV_API_URL}/v1/systemone with Bearer JEV_API_KEY.
JEV_API_URL=https://api.typesafe.ai
JEV_API_KEY=
# Pinned model version — never "jev-latest". The response's `model` field is
# recorded in the audit log so every signal pins its model version.
JEV_MODEL=jev-1.13.0
# When true, JevClient returns a mock P(true) and makes no network calls.
JEV_MOCK=true

# --- Risk gate ---
# Minimum FEE-ADJUSTED |P(true) - market price| to act (0.10 = 10%).
EDGE_THRESHOLD=0.10
# Fraction of the full Kelly stake to actually risk (0.25 = quarter-Kelly).
KELLY_FRACTION=0.25
# Max notional for one market, as a fraction of bankroll.
MAX_PER_MARKET_FRAC=0.10
# Max total exposure across all positions, as a fraction of bankroll.
MAX_TOTAL_EXPOSURE_FRAC=0.40
# Max concurrent open positions; the gate vetoes beyond this.
MAX_CONCURRENT_POSITIONS=5
# Veto if bid-ask spread exceeds this (USD dollars; 0.03 = 3 cents).
SPREAD_VETO_CENTS=0.03
# Veto if top-of-book (best bid+ask) resting USD is below this.
MIN_TOP_DEPTH_USD=50.0
# Veto if the market resolves sooner than this (hours).
MIN_HOURS_TO_RESOLUTION=2.0
# Veto if the news snapshot is older than the price snapshot by more than
# this (seconds); unknown timestamps are fail-closed (vetoed).
MAX_NEWS_PRICE_SKEW_SEC=900
# NegRisk sanity: YES+NO token prices must sum inside this band.
NEGRISK_SUM_MIN=0.98
NEGRISK_SUM_MAX=1.02
# Veto if Jev's typed-choice confidence is below this.
JEV_CONFIDENCE_MIN=0.6

# --- Kill switch ---
# Auto-engage when paper equity drawdown from starting bankroll hits this (%).
KILL_DRAWDOWN_PCT=15

# --- Paper trading ---
PAPER_BANKROLL_USD=10000
# Per-market authoritative taker-fee rate override (0 = disabled; the
# category table in app/execution/paper.py applies instead).
FEE_RATE_OVERRIDE=0.0

# --- Scraper sources ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=hunchfall-paper/0.1
GDELT_ENABLED=true
# X/Twitter is EXCLUDED BY DESIGN (pay-per-use ~$0.005/read + ToS risk).
TWITTER_ENABLED=false

# --- Loop ---
# Seconds between cycles in --watch mode.
LOOP_INTERVAL_SEC=300

# --- Storage / API ---
# SQLite audit log path (relative paths resolve under backend/).
DATABASE_PATH=data/hunchfall.db
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated allowed CORS origins for the dashboard.
CORS_ORIGINS=http://localhost:3000
